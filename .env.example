# Copy this file to .env.local and fill in values from
# Supabase Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The public address of the app. Used for links in emails and password-reset
# links. Local: http://localhost:3000   Production: https://your-domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email and daily reminders (optional but recommended in production) ---
# Resend (resend.com). Without these the app still works; nobody is emailed.
# EMAIL_FROM must be an address on a domain you have verified with Resend.
# RESEND_API_KEY=your-resend-key
# EMAIL_FROM=SAKSHA <notifications@your-domain>
#
# Protects /api/cron/notify. Any long random string. Vercel sends it for you.
# CRON_SECRET=generate-a-long-random-string

# Password used for all seeded demo accounts (npm run seed).
# Local development only: do NOT set this on the production server.
DEMO_PASSWORD=change-me-demo-password

# AI assistant. Two providers, same features.
#
# 1) Local model (default for development; does not work on Vercel):
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
AI_MODEL=llama3.2
#
# 2) Any OpenAI-compatible endpoint (Groq, OpenRouter, Gemini's
#    compatibility layer, Cerebras, GitHub Models). Example:
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
# AI_API_KEY=your-free-tier-key
#
# The key is read on the server only and is never sent to the browser.

# Tried once if the main model is missing, rate-limited or erroring.
# Pick a smaller model on the same provider, e.g. on Groq:
AI_MODEL_FALLBACK=llama-3.3-70b-versatile

# Hard cap on how long one reply may be. Protects a free-tier quota.
AI_MAX_TOKENS=700

# `npm run eval:ai` fails below this pass rate (0-1).
AI_EVAL_THRESHOLD=0.85
