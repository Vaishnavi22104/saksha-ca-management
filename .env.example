# Copy this file to .env.local and fill in values from
# Supabase Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password used for all seeded demo accounts (npm run seed)
DEMO_PASSWORD=change-me-demo-password

# Planned for the AI phase (30 Sep)
OLLAMA_BASE_URL=http://localhost:11434
