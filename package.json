{
  "name": "saksha-ca-management",
  "version": "0.1.0",
  "private": true,
  "description": "SAKSHA — CA practice management: clients, recurring workflows, documents, messages and an AI assistant, with permissions enforced by the database.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "eval:ai": "node scripts/eval-ai.mjs",
    "typecheck": "tsc --noEmit",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "create-firm": "node --env-file=.env.local scripts/create-firm.mjs",
    "reset-password": "node --env-file=.env.local scripts/reset-password.mjs"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  }
}
